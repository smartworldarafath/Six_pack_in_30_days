<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/dp_2" />
            <solid android:color="@color/black_10" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/dp_2" />
                <gradient android:startColor="@color/adjust_gradient_start" android:endColor="@color/adjust_gradient_end" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>
