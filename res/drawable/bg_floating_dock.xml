<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Depth Base Lip -->
    <item android:top="2.5dip">
        <shape android:shape="rectangle">
            <corners android:radius="28.0dip" />
            <solid android:color="#12000000" />
        </shape>
    </item>
    <!-- Main Floating Capsule Surface with 3D Light Gradient -->
    <item android:bottom="2.0dip">
        <shape android:shape="rectangle">
            <corners android:radius="28.0dip" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#FCFDFF"
                android:endColor="#F4F6FB"
                android:type="linear" />
            <stroke
                android:width="1.0dip"
                android:color="#182A3A55" />
        </shape>
    </item>
</layer-list>
